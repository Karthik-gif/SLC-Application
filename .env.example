# Copy to .env — .env is gitignored and must never be committed.
# Password for the SAP technical user named in config/services.json.
SAP_DS4_100_NIIF_PASSWORD=

# Gateway port. Replaces the old per-console ports 8765-8775.
PORT=8080

# Point the backend registry somewhere else (tests, local mocks). Defaults to config/services.json.
# SLC_SERVICES_CONFIG=

# Demo login credentials (demo auth mode only — not a security boundary).
DEMO_USER=demo
DEMO_PASSWORD=demo
